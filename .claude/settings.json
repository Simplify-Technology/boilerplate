{
  "enabledMcpjsonServers": ["laravel-boost"],

  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },

  "env": {
    "SECURITY_REVIEW_MODEL": "claude-sonnet-5"
  },

  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ci-gate.sh baseline",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh",
            "timeout": 10,
            "statusMessage": "guard-git: checando o comando…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ci-gate.sh check",
            "timeout": 300,
            "statusMessage": "ci-gate: pint + pest (+ tsc/eslint/vitest se tocou o frontend)…"
          }
        ]
      }
    ]
  }
}
