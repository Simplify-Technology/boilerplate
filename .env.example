APP_NAME="Boilerplate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://simplify-technology-boilerplate.test

# Proxies confiáveis p/ X-Forwarded-* (habilite quando estiver atrás de
# load balancer/CDN; lista separada por vírgula ou `*`).
# TRUSTED_PROXIES=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_boilerplate
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Hardening da sessão (prod/HTTPS): Secure cookie e SameSite.
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="dev@local.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Inertia SSR (config/inertia.php)
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
# INERTIA_SSR_RUNTIME=node
# INERTIA_ENCRYPT_HISTORY=false

# Horizon (config/horizon.php)
HORIZON_PATH=horizon
# HORIZON_NAME=
# HORIZON_DOMAIN=
# HORIZON_PREFIX=

# Log viewer (opcodesio/log-viewer — config/log-viewer.php)
LOG_VIEWER_ENABLED=true
LOG_VIEWER_API_ONLY=false
# LOG_VIEWER_API_STATEFUL_DOMAINS=
# LOG_VIEWER_CACHE_DRIVER=
# LOG_VIEWER_PRODUCTION_TOKEN=

# Audit trail (spatie/activitylog — config/activitylog.php)
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_BUFFER_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
